# --- Terraform ---
.terraform/
*.tfstate
*.tfstate.*
*.tfplan
crash.log
crash.*.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json
# Real values stay local, only examples are committed
*.tfvars
*.tfvars.json
!*.tfvars.example
# Lock files are committed for root configurations only,
# reusable modules leave provider pinning to their callers
terraform/modules/*/.terraform.lock.hcl

# --- Secrets and local config ---
.env
.env.*
!.env.example
*.pem
*.key
kubeconfig
*.kubeconfig
age.key

# --- Ansible ---
*.retry
ansible/inventory/hosts.yml

# --- Editors / OS ---
.idea/
.vscode/
*.swp
.DS_Store

# --- State backend ---
# Rendered from backend/s3.json.tpl with real keys
backend/s3.json
ansible/kubeconfig

# --- GitOps ---
# Chart dependencies are pulled by helm dependency build, Chart.lock is committed
gitops/**/charts/
